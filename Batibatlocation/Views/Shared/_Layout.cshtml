<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="Besoin d'échafaudages solides et sécurisés ? Notre société de location, basée à Rouvray près d'Auxerre (89000 - 89230), vous propose des solutions adaptées.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="msvalidate.01" content="BD28ED4BE1B7008A410DEAC046B74E0C" />
    <meta name="google-site-verification" content="rn9QmKp6l_mt4Mnj-UPRGS9gepdIFqGC42PCdqEszAo" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />

    <meta name="keywords" content="location échafaudages M49, échafaudages 60m², échafaudages 100m², location bétonnière, matériel de chantier Auxerre 89000, location équipements BTP ou BTB, location échafaudages Rouvray 89230, location échafaudages Auxerre 89000, location matériel construction France">
    <meta name="author" content="Bati'Bat">
    <meta name="robots" content="index, follow">

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:title" content="Location d’échafaudages et bétonnières - Bati'Bat">
    <meta property="og:description" content="Trouvez les meilleurs échafaudages M49 et bétonnières en location à Auxerre. Sécurité, conformité et prix compétitifs.">
    <meta property="og:image" content="https://www.batibatlocation.com/logo-batibat.png">
    <meta property="og:url" content="https://www.batibatlocation.com">
    <meta property="og:type" content="business.business">
    <meta property="og:locale" content="fr_FR">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Location d’échafaudages et bétonnières à Auxerre - Bati'Bat">
    <meta name="twitter:description" content="Spécialiste de la location d’échafaudages et bétonnières à Rouvray 89230, France. Contactez-nous pour vos projets BTP.">
    <meta name="twitter:image" content="https://www.batibatlocation.com/logo-batibat.png">

    <!-- Geolocalisation Google -->
    <meta name="geo.region" content="FR-89"> <!-- Département de l'Yonne -->
    <meta name="geo.placename" content="Rouvray, Auxerre">
    <meta name="geo.position" content="47.893328865133746;3.668713176200149"> <!-- Coordonnées GPS -->
    <meta name="ICBM" content="47.893328865133746, 3.668713176200149">

    <link rel="canonical" href="https://www.batibatlocation.com/">

    <title>@ViewBag.Title</title>

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "LocalBusiness",
            "name": "Batibat",
            "url": "https://www.batibatlocation.com/",
            "logo": {
                "@@type": "ImageObject",
                "url": "https://www.batibatlocation.com/logo-batibat.png",
                "width": 3334,
                "height": 2501
            },
            "sameAs": [
                "https://wa.me/+330695889208"
            ],
            "address": {
                "@@type": "PostalAddress",
                "streetAddress": "19 Route de Montigny la Resle",
                "addressLocality": "Rouvray",
                "postalCode": "89230",
                "addressCountry": "FR"
            },
            "telephone": "+330695889208",
            "email": "mailto:batibatlocation@gmail.com",
            "openingHoursSpecification": [
                {
                  "@@type": "OpeningHoursSpecification",
                  "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                  "opens": "09:00",
                  "closes": "18:00"
                },
                {
                  "@@type": "OpeningHoursSpecification",
                  "dayOfWeek": "Saturday",
                  "opens": "Closed"
                },
                {
                  "@@type": "OpeningHoursSpecification",
                  "dayOfWeek": "Sunday",
                  "opens": "Closed"
                }
              ]
        }
    </script>

    @Styles.Render("~/Content/css")

</head>
<body>
    <h1 class="d-none"></h1>
    <div class="main-wrapper">
        @*Navbar*@
        <header id="navbar" class="navbar-home">
            @if (Request.IsAuthenticated)
            {
                <div id="topbaradmin" class="top-bar top-bar-admin bg-dark text-white py-2">
                    <div class="container-md">
                        <div class="row align-items-center">
                            <!-- Sezione Indirizzo -->

                            <div class="offset-md-8"></div>
                            <div class="col-md-4 col-6 text-center text-md-right">
                                <a href="@Url.Action("Dashboard", "Admin")" class="home-link">
                                    Admin
                                    <i class="fa-solid fa-screwdriver-wrench"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div id="topbar" class="top-bar bg-dark text-white py-2">
                <div class="container-md">
                    <div class="row align-items-center">
                        <!-- Sezione Indirizzo -->
                        <div class="col-md-4 col-6 text-center text-md-left">
                            <i class="fas fa-map-marker-alt"></i> Rouvray 89230
                        </div>
                        <!-- Sezione Numero di Telefono -->
                        <div class="col-md-4 col-6 text-center">
                            <i class="fas fa-phone-alt"></i> +33 06 95889208
                        </div>
                        <!-- Sezione Icone Social -->
                        <div class="social-icons col-md-4 text-center text-md-right">
                            <div class="row">
                                <div class="col-md-6"></div>
                                <div class="col-md-6">
                                    <div class="row">
                                        <!-- Facebook -->
                                        <div class="col-4 social-icon" id="facebook">
                                            <a href="https://www.facebook.com" target="_blank" class="disabled-link text-white d-flex justify-content-center align-items-center">
                                                <i class="fab fa-facebook-f"></i>
                                            </a>
                                        </div>
                                        <!-- Instagram -->
                                        <div class="col-4 social-icon" id="instagram">
                                            <a href="https://www.instagram.com" target="_blank" class="disabled-link text-white d-flex justify-content-center align-items-center">
                                                <i class="fab fa-instagram"></i>
                                            </a>
                                        </div>
                                        <!-- WhatsApp -->
                                        <div class="col-4 social-icon" id="whatsapp">
                                            <a href="https://wa.me/+330695889208" target="_blank" class="text-white d-flex justify-content-center align-items-center">
                                                <i class="fab fa-whatsapp"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container-md">

                <nav class="navbar navbar-expand-md navbar-dark">

                    <a class="navbar-brand" href="@Url.Action("Index","Home")">

                        <img id="idBrandImg" src="~/Content/Images/LogoBatibatSVGTetto.svg" alt="Brand Bati'Bat PNG" srcset="">
                    </a>
                    <button class="navbar-toggler d-flex align-items-center justify-content-center" type="button" id="menuToggle" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <svg id="hambIcon" width="35" height="25" viewBox="0 0 30 30">

                            <rect x="0" width="35" height="3" fill="black"></rect>
                            <!-- <rect x="10" width="10"  height="3" fill="white"></rect>
                            <rect x="25" width="10"  height="3" fill="white"></rect> -->

                            <rect y="13" x="0" width="25" height="3" fill="black"></rect>
                            <!-- <rect y="13" x="30" width="5" height="3" fill="white"></rect> -->

                            <rect y="26" width="15" height="3" fill="black"></rect>
                            <rect y="26" x="20" width="15" height="3" fill="black"></rect>
                        </svg>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ml-auto">
                            <li class="nav-item">
                                <a id="homeBtn" class="nav-link" href="@Url.Action("Index","Home")">Accueil</a>
                            </li>
                            <li class="nav-item" id="nosProduits">
                                <a class="nav-link" href="@Url.Action("Index","Home")#produits">Nos Produits</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index","Home")#services">Nos Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index","Home")#contact">Contact</a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </header>

        <!-- Menu Laterale -->
        <div id="sideMenu" class="side-menu">
            <button id="closeMenu" class="close-menu">&times;</button>
            <ul class="side-menu-nav">
                <li><a id="homeBtn2" class="nav-link" href="@Url.Action("Index","Home")">Accueil</a></li>
                <li id="nosProduitsSideBar"><a class="nav-link" href="@Url.Action("Index","Home")#produits">Nos Produits</a></li>
                <li><a class="nav-link" href="@Url.Action("Index","Home")#services">Nos Services</a></li>
                <li><a class="nav-link" href="@Url.Action("Index","Home")#contact">Contact</a></li>
            </ul>
        </div>

        <main id="main" style="margin-bottom: 3rem;">
            @RenderBody()
        </main>


        <footer class="bg-dark text-white py-3 text-center">
            <div class="container">
                <p class="mb-0">
                    <i class="fa fa-cc"></i> @DateTime.Now.Year BATI'BAT Location d'Echafaudages. Tous droits réservés.
                    <br>
                    <i class="fa fa-paint-brush"></i> Powered by:
                    <a href="mailto:andry.almas@gmail.com" target="_blank">
                        @@AndryAlmas
                    </a>
                </p>
            </div>
        </footer>

        <!-- Pulsante "To Top" -->
        <button class="to-top-btn" id="toTopBtn" aria-label="Go to top">
            <i class="fas fa-chevron-up"></i>
        </button>
    </div>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/popper")
    @Scripts.Render("~/bundles/fontawesome")
    @Scripts.Render("~/bundles/glide")
    @Scripts.Render("~/bundles/custom")
    @RenderSection("Scripts", required: false)

    @Html.Partial("_ModalConfirm")
    @Html.Partial("_AlertMessage")


</body>
</html>
