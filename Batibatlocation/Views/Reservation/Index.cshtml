    }

    .flatpickr-day {
        width: auto !important;
        height: 40px !important; /* Altezza fissa */
        line-height: 40px !important; /* Allinea il testo al centro verticalmente */
        font-size: 16px !important; /* Dimensione del testo */
        text-align: center !important; /* Allinea il testo al centro orizzontalmente */
        max-width: none !important;
        border-radius: 0 !important;
    }

    .flatpickr-day {
        font-weight: bold;
        font-size: large;
    }

        .flatpickr-day.flatpickr-disabled, .flatpickr-day.flatpickr-disabled:hover {
            color: #c8c8c8;
        }

        .flatpickr-day.today {
            color: red !important;
        }

    .flatpickr-calendar.inline {
        display: block !important;
        position: static !important;
        margin: 0 auto !important;
        width: auto !important;
        /*max-width: 307.875px !important;*/
        margin-top: 1rem !important;
    }

    .flatpickr-calendar {
        padding: 0.5vw !important;
        border: 2px solid black !important;
    }

    .flatpickr-innerContainer {
        flex-direction: column-reverse;
        justify-content: center;
    }

    .flatpickr-months .flatpickr-prev-month.flatpickr-next-month, .flatpickr-months .flatpickr-next-month.flatpickr-next-month {
        right: 34px !important;
    }

    .flatpickr-months .flatpickr-prev-month.flatpickr-prev-month, .flatpickr-months .flatpickr-next-month.flatpickr-prev-month {
        left: 34px !important;
    }

    .flatpickr-months .flatpickr-prev-month, .flatpickr-months .flatpickr-next-month {
        top: 60px !important;
        border-radius: 50% !important;
        background: #dedede !important;
    }

    .flatpickr-next-month svg {
