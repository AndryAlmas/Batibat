                        </div>
                        <br />
                        <!-- Pulsante Calcola Preventivo -->
                        <div class="d-grid text-end" style="margin-bottom: 5rem !important">
                            <button type="button" id="calculateQuote" class="btn btn-primary btn-lg float-right">
                                <span id="buttonText">Calculer le devis</span>
                                <span id="spinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            </button>
                            <input type="hidden" id="localisationTrack" name="localisationTrack" />
                            <input type="hidden" id="devisIdTrack" name="devisIdTrack" />

                        </div>

                        <!-- Risultato -->
                        <div id="result" class="mt-4 text-center"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        let deliveryEnabled = false;

        // Variabili globali per la mappa e il marker
        let map;
        let marker;

        // Funzione per inizializzare la mappa
        function initializeMap() {
            map = L.map('map').setView([48.8566, 2.3522], 15); // Coordinate di default (Parigi)

            // Aggiungi un layer di tile (stile Stadia Maps)
            L.tileLayer('https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png', {
                maxZoom: 20,
                attribution: '&copy; <a href="https://stadiamaps.com/">Stadia Maps</a>'
            }).addTo(map);

            //// Aggiungi un marker iniziale
            //marker = L.marker([48.8566, 2.3522]).addTo(map);
        }

        // Funzione per rimuovere il marker e ricaricare la mappa
        function clearMap() {
            if (map) {
                // Rimuovi il marker corrente (se esiste)
                if (marker) {
                    map.removeLayer(marker);
                    marker = null; // Resetta il marker
                }

                // Forza il ricalcolo delle dimensioni della mappa
                map.invalidateSize();

                // Reimposta la vista della mappa su Parigi (o altre coordinate di default)
                map.setView([48.8566, 2.3522], 15); // Coordinate di Parigi
            }
        }

        // Funzione per aggiornare la mappa con nuove coordinate
        function updateMap(lat, lon) {
            if (!map) return;

            // Validazione delle coordinate
            if (isNaN(lat) || isNaN(lon)) {
                console.error("Coordinate non valide:", { lat, lon });
                return;
            }

            // Rimuovi il marker precedente (se esiste)
            if (marker) map.removeLayer(marker);

            // Aggiorna il centro della mappa
            map.setView([lat, lon], 15);

            // Aggiorna le dimensioni della mappa (se necessario)
            map.invalidateSize();

            // Aggiungi un nuovo marker
            marker = L.marker([lat, lon]).addTo(map);
        }

        function reloadMap() {
            if (map) {
                map.invalidateSize(); // Aggiorna le dimensioni della mappa
                map.eachLayer(layer => {
                    if (layer instanceof L.TileLayer) {
                        layer.redraw(); // Forza il ricaricamento delle tiles
                    }
                });
            }
        }


        // Inizializza la mappa all'avvio
        //$(document).ready(function () {
        //    initializeMap();
        //});

        document.addEventListener("DOMContentLoaded", function () {
            // Oggetto globale per tenere traccia dei calendari
            const flatpickrInstances = {};

            function generateAvailableDates(startDate) {
                const availableDates = [];
                if (startDate != undefined) {
                    let currentDate = new Date(startDate);

                    // Helper per formattare la data in DD/MM/YYYY
                    function formatDate(date) {
                        const day = String(date.getDate()).padStart(2, '0'); // Giorno con zero iniziale
                        const month = String(date.getMonth() + 1).padStart(2, '0'); // Mese con zero iniziale
                        const year = date.getFullYear();
                        return `${day}/${month}/${year}`;
                    }

                    const nextDate = new Date(currentDate); // Crea una nuova data basata sulla data corrente
                    for (let i = 1; i <= 52; i++) { // Genera fino a 52 settimane - 1 anno (puoi modificare il limite)
                        if (i == 1) {
                            nextDate.setDate(nextDate.getDate() + 6); // Aggiungi 6 per la prima settimana
                        }
                        else {
                            nextDate.setDate(nextDate.getDate() + 7); // Aggiungi 7 giorni alla volta
                        }
                        availableDates.push({
                            display: formatDate(nextDate), // Formato visibile (DD/MM/YYYY)
                            value: nextDate.toISOString().split('T')[0] // Formato interno (YYYY-MM-DD)
                        });
                    }
                }
                return availableDates;
            }

            // Inizializza Flatpickr per tutti i campi con classe "flatpickr-inline"
            const initializeFlatpickr = (calendarId, inputId, isStartDate) => {
                const calendarElement = document.getElementById(calendarId);
                const inputElement = document.getElementById(inputId);

                const picker = flatpickr(calendarElement, {
                    dateFormat: "d/m/Y",
                    locale: "fr",
                    inline: true,
                    minDate: "today",
                    onMonthChange: function (selectedDates, dateStr, instance) {
                        checkAndApplySelectedClasses(calendarId, inputId);
                    },
                    onChange: function (selectedDates, dateStr) {
                        inputElement.value = dateStr;
                        $("#result").hide();
                        const endDateInputId = inputId.replace('StartDate', 'EndDate');
                        const endDateCalendarId = calendarId.replace('StartDate', 'EndDate');
                        const endDateInput = document.getElementById(endDateInputId);
                        const endDatePicker = flatpickrInstances[endDateInputId + "Picker"];

                        if (isStartDate) {
                            //elimino tutti i selected dai due calendari
                            if (endDateInput && endDatePicker) {
                                endDateInput.value = '';
                                $("#" + endDateCalendarId).nextAll("div").removeClass("disabled-calendar");



                                if (inputElement.dataset.type === "Semaine") {
                                    const availableDates = generateAvailableDates(selectedDates[0]);

                                    if (availableDates.length > 0) {
                                        endDatePicker.set({
                                            enable: availableDates.map(date => ({ from: date.display, to: date.display })),
                                            minDate: selectedDates[0]
                                        });

                                        // Calcola la data di inizio + 6 giorni
                                        const startDatePlus6Days = new Date(selectedDates[0]);
                                        startDatePlus6Days.setDate(startDatePlus6Days.getDate() + 6);

                                        // Imposta la vista del calendario sul mese di startDatePlus6Days
                                        endDatePicker.setDate(startDatePlus6Days, true, { view: 'month' });
                                    }
                                    else {
                                        endDatePicker.set({
                                            enable: [],
                                            minDate: "today"
                                        });
                                    }
                                } else {
                                    endDatePicker.set({
                                        minDate: selectedDates[0]
                                    });
                                }


                            }
                        }
                        // Controlla se entrambi gli input sono valorizzati
                        checkAndApplySelectedClasses(calendarId, inputId);
                    }
                });
                return picker;
            };

            // Inizializza tutti i calendari all'avvio
            flatpickrInstances.privateStartDatePicker = initializeFlatpickr("privateStartDateCalendar", "privateStartDate", true);
            flatpickrInstances.privateEndDatePicker = initializeFlatpickr("privateEndDateCalendar", "privateEndDate", false);
            flatpickrInstances.companyStartDatePicker = initializeFlatpickr("companyStartDateCalendar", "companyStartDate", true);
            flatpickrInstances.companyEndDatePicker = initializeFlatpickr("companyEndDateCalendar", "companyEndDate", false);
            $("#privateEndDateCalendar").nextAll("div").addClass("disabled-calendar");
            $("#companyEndDateCalendar").nextAll("div").addClass("disabled-calendar");

            // Funzione per resettare i calendari
            const resetCalendars = () => {
                flatpickrInstances.privateStartDatePicker.clear() //.setDate("today");
                flatpickrInstances.companyStartDatePicker.clear() //.setDate("today");

                flatpickrInstances.privateEndDatePicker.clear();
                flatpickrInstances.companyEndDatePicker.clear();

                flatpickrInstances.privateStartDatePicker = initializeFlatpickr("privateStartDateCalendar", "privateStartDate", true);
                flatpickrInstances.privateEndDatePicker = initializeFlatpickr("privateEndDateCalendar", "privateEndDate", false);
                flatpickrInstances.companyStartDatePicker = initializeFlatpickr("companyStartDateCalendar", "companyStartDate", true);
                flatpickrInstances.companyEndDatePicker = initializeFlatpickr("companyEndDateCalendar", "companyEndDate", false);

                document.getElementById("privateStartDate").value = "";
                document.getElementById("privateEndDate").value = "";
                document.getElementById("companyStartDate").value = "";
                document.getElementById("companyEndDate").value = "";

                $("#privateEndDateCalendar").nextAll("div").addClass("disabled-calendar");
                $("#companyEndDateCalendar").nextAll("div").addClass("disabled-calendar");
            };

            // Gestione del cambio di stato tra Privé e Professionnel
            $('input[name="userType"]').change(function () {
                $('#privateRadio + label').toggleClass('active-devis', $('#privateRadio').is(':checked'));
                $('#professionalRadio + label').toggleClass('active-devis', $('#professionalRadio').is(':checked'));

                // Azzera i campi quando si cambia tipo di utente
                if ($('#privateRadio').is(':checked')) {
                    $('#privateForm input').val('').trigger('change'); // Azzera campi Privé
                    $('#privateForm').show();
                    $('#professionalForm').hide();
                } else {
                    $('#professionalForm input').val('').trigger('change'); // Azzera campi Professionnel
                    $('#privateForm').hide();
                    $('#professionalForm').show();
                }
                resetCalendars();
                $('#sansLivraison').click();
                $('#endAddress').val("");
                $('#endAddress').text("");
                $('#result').html("");
            });

            function checkAndApplySelectedClasses(calendarId, inputId) {
                const startDateInputId = inputId.replace('EndDate', 'StartDate');
                const endDateInputId = inputId.replace('StartDate', 'EndDate');

                const startDateStr = document.getElementById(startDateInputId).value;
                const endDateStr = document.getElementById(endDateInputId).value;

                if (startDateStr && endDateStr) {
                    const startDate = parseDate(startDateStr);
                    const endDate = parseDate(endDateStr);

                    if (startDate && endDate && startDate <= endDate) {
                        // Applica la classe .selected al primo calendario
                        const startCalendarElement = document.getElementById(calendarId.replace('EndDate', 'StartDate'));
                        // TODO - applica stile personalizzato alla data selezionata.
                        addSelectedClassToFirstDate(startCalendarElement, startDate, endDate);

                        // Applica la classe .selected al secondo calendario
                        const endCalendarElement = document.getElementById(calendarId.replace('StartDate', 'EndDate'));
                        addSelectedClassToDates(endCalendarElement, startDate, endDate);
                    }
                }
            }

            function addSelectedClassToFirstDate(calendarElement, startDate, endDate) {
                // Seleziona tutti gli elementi .flatpickr-day nel calendario
                const flatpickrCalendar = calendarElement.nextElementSibling;
                const dayElements = flatpickrCalendar.querySelectorAll(".flatpickr-day");

                dayElements.forEach(day => {
                    // Ignora gli elementi con la classe .nextMonth o .prevMonth
                    //if (day.classList.contains("nextMonthDay") || day.classList.contains("prevMonthDay")) {
                    //    day.classList.remove("selected"); // rimuovo in caso sia già stato selezionato in precedenza
                    //    return;
                    //}

                    // Ottieni la data associata all'elemento
                    const dateStr = day.getAttribute("aria-label");
                    if (!dateStr) return;

                    const parsedDate = parseFrenchDate(dateStr);
                    const date = new Date(parsedDate);

                    // Verifica se la data è compresa nell'intervallo
                    if (areDatesEqual(date,startDate)) {
                        day.classList.remove("selected");
                        day.classList.add("selected-first");
                    } else {
                        day.classList.remove("selected-first");
                    }
                });
            }

            function areDatesEqual(date1, date2) {
                if (!date1 || !date2) return false;

                return (
                    date1.getFullYear() === date2.getFullYear() &&
                    date1.getMonth() === date2.getMonth() &&
                    date1.getDate() === date2.getDate()
                );
            }

            function addSelectedClassToDates(calendarElement, startDate, endDate) {
                // Seleziona tutti gli elementi .flatpickr-day nel calendario
                const flatpickrCalendar = calendarElement.nextElementSibling;
                const dayElements = flatpickrCalendar.querySelectorAll(".flatpickr-day");

                dayElements.forEach(day => {
                    // Ignora gli elementi con la classe .nextMonth o .prevMonth
                    if (day.classList.contains("nextMonthDay") || day.classList.contains("prevMonthDay")) {
                        day.classList.remove("selected"); // rimuovo in caso sia già stato selezionato in precedenza
                        return;
                    }

                    // Ottieni la data associata all'elemento
                    const dateStr = day.getAttribute("aria-label");
                    if (!dateStr) return;

                    const parsedDate = parseFrenchDate(dateStr);
                    const date = new Date(parsedDate);

                    // Verifica se la data è compresa nell'intervallo
                    if (date >= startDate && date <= endDate) {
                        if (!day.getAttribute("tabindex")) // controllare che non ci sia nextMonth o prevMonth perché altrimenti lo colora nella parte di calendario sbagliata
                            day.classList.add("selected");
                        else {
                            day.classList.remove("selected");
                            if (areDatesEqual(date, endDate)) {
                                day.classList.remove("selected-option");
                                day.classList.add("selected-max");
                            }
                            else {
                                day.classList.remove("selected-max");
                                day.classList.add("selected-option");
                            }
                        }
                    } else {
                        day.classList.remove("selected");
                        day.classList.remove("selected-max");
                        day.classList.remove("selected-option");
                    }
                });
            }
            // Funzione per convertire una stringa dd/mm/yyyy in un oggetto Date
            function parseDate(dateStr) {
                const [day, month, year] = dateStr.split("/").map(Number); // Dividi la stringa e converti in numeri
                return new Date(year, month - 1, day); // Crea un oggetto Date (mese è zero-based)
            }

            function parseFrenchDate(dateStr) {
                // Mapping dei nomi dei mesi francesi
                const frenchMonths = {
                    "janvier": 0, "février": 1, "mars": 2, "avril": 3,
                    "mai": 4, "juin": 5, "juillet": 6, "août": 7,
                    "septembre": 8, "octobre": 9, "novembre": 10, "décembre": 11
                };

                // Estrai il mese, il giorno e l'anno dalla stringa
                const parts = dateStr.toLowerCase().split(" ");
                if (parts.length !== 3) {
                    console.error("Formato della data non valido:", dateStr);
                    return null;
                }

                const monthName = parts[0]; // Mese in francese
                const day = parseInt(parts[1].replace(",", ""), 10); // Giorno (rimuovi la virgola)
                const year = parseInt(parts[2], 10); // Anno

                // Trova il numero del mese corrispondente
                const month = frenchMonths[monthName];
                if (month === undefined) {
                    console.error("Mese non riconosciuto:", monthName);
                    return null;
                }

                // Crea un oggetto Date (il mese è zero-based in JavaScript)
                return new Date(year, month, day);
            }
        });

        let selectedStart = null;
        let selectedEnd = null;

        document.getElementById('avecLivraison').addEventListener('click', function () {
            this.classList.add('active-devis');
            $('#deliverySection').show();
            $('#result').hide();
            clearMap();
            reloadMap();
            document.getElementById('sansLivraison').classList.remove('active-devis');
            deliveryEnabled = true;
        });

        document.getElementById('sansLivraison').addEventListener('click', function () {
            this.classList.add('active-devis');
            $('#deliverySection').hide();
            $('#result').hide();
            selectedStart = null;
            selectedEnd = null;
            $('#endAddress').val("");
            $('#endAddress').text("");
            document.getElementById('avecLivraison').classList.remove('active-devis');
            deliveryEnabled = false;
        });

        let debounceTimer; // Variabile per memorizzare il timer

        // Funzione per ottenere suggerimenti di indirizzi tramite Nominatim
        function getSuggestions(inputId, suggestionsId, callback) {
            const query = $('#' + inputId).val();
            if (query.length < 3) return; // Attiva la ricerca solo dopo 3 caratteri

            const suggestionsList = $('#' + suggestionsId);
            const spinner = suggestionsList.find('.spinner'); // Trova lo spinner

            // Mostra lo spinner e nascondi eventuali risultati precedenti
            suggestionsList.empty().append(spinner).show();
            spinner.show();


            // Cancella il timer precedente (se esiste)
            clearTimeout(debounceTimer);

            // Imposta un nuovo timer per ritardare la chiamata API
            // Imposta un nuovo timer per ritardare la chiamata API
            debounceTimer = setTimeout(() => {
                $.ajax({
                    url: `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=5&accept-language=fr&countrycodes=FR`,
                    method: 'GET',
                    beforeSend: function () {
                        // Mostra lo spinner prima di inviare la richiesta
                        suggestionsList.empty().append(spinner).show();
                        spinner.show();
                    },
                    success: function (data) {
                        suggestionsList.empty().append(spinner);
                        if (data && data.length > 0) {
                            data.forEach(item => {
                                const suggestion = $('<li>')
                                    .addClass('list-group-item')
                                    .text(item.display_name);

                                suggestion.click(function () {
                                    $('#' + inputId).val(item.display_name);
                                    suggestionsList.empty().append(spinner).hide();
                                    const lat = parseFloat(item.lat);
                                    const lon = parseFloat(item.lon);
                                    updateMap(lat, lon);
                                    callback({ lat: item.lat, lon: item.lon });
                                });

                                suggestionsList.append(suggestion);
                            });
                        } else {
                            // Nessun risultato trovato
                            suggestionsList.empty().append(spinner).append(
                                $('<li>').addClass('list-group-item text-muted').text('Aucun résultat trouvé')
                            );
                        }
                    },
                    error: function () {
                        // Errore durante la ricerca
                        suggestionsList.empty().append(spinner).append(
                            $('<li>').addClass('list-group-item text-danger').text('Erreur lors de la recherche')
                        );
                    },
                    complete: function () {
                        // Nascondi lo spinner alla fine della richiesta (successo o errore)
                        spinner.hide();
                    }
                });
            }, 300); // Ritardo di 300 ms prima di inviare la richiesta
        }

        // Gestione dell'input di arrivo
        $('#endAddress').on('input', function () {
            getSuggestions('endAddress', 'endSuggestions', function (coords) {
                selectedEnd = coords;
            });
        });

        // Funzione di validazione dei campi
        function validateFields(userType) {
            let errors = [];

            if (userType === 'private') {
                // Validazione per Privé
                if (!$('#privateName').val()) errors.push("Le nom et prénom sont obligatoires.");
                if (!$('#privateEmail').val()) errors.push("L'adresse e-mail est obligatoire.");
                if (!$('#privateTelephone').val()) errors.push("Le numéro de téléphone est obligatoire.");
                if (!$('#privateStartDate').val()) errors.push("La date de début de location est obligatoire.");
                if (!$('#privateEndDate').val()) errors.push("La date de fin de location est obligatoire.");
            } else {
                // Validazione per Professionnel
                if (!$('#companyName').val()) errors.push("Le nom de l'entreprise est obligatoire.");
                if (!$('#companyEmail').val()) errors.push("L'adresse e-mail est obligatoire.");
                if (!$('#companyTelephone').val()) errors.push("Le numéro de téléphone est obligatoire.");
                if (!$('#companyStartDate').val()) errors.push("La date de début de location est obligatoire.");
                if (!$('#companyEndDate').val()) errors.push("La date de fin de location est obligatoire.");
            }

            // Validazione generale per la consegna
            if (deliveryEnabled) {
                if (!selectedEnd || selectedEnd == 0) errors.push("Veuillez sélectionner l'adresses de livraison.");
            }

            return errors;
        }

        // Funzione unica per calcolare il preventivo
        $('#calculateQuote').click(function () {
            const button = $(this); // Riferimento al pulsante
            const buttonText = $('#buttonText'); // Testo del pulsante
            const spinner = $('#spinner'); // Spinner

            // Determina il tipo di utente
            const userType = $('input[name="userType"]:checked').val();

            // Dati comuni
            const startDate = userType === 'private' ? $('#privateStartDate').val() : $('#companyStartDate').val();
            const endDate = userType === 'private' ? $('#privateEndDate').val() : $('#companyEndDate').val();
            const devisId = $('#devisIdTrack').val();

            // Validazione dei campi
            const validationErrors = validateFields(userType);
            if (validationErrors.length > 0) {
                $('#result').html(`<div class="alert alert-danger">${validationErrors.join("<br>")}</div>`);
                $('#result').show();
                return;
            }

            // Preparazione dei dati da inviare al backend
            const dataToSend = {
                UserType: userType,
                ProdID: @ViewBag.ProdID,
                Name: userType === 'private' ? $('#privateName').val() : $('#companyName').val(),
                Email: userType === 'private' ? $('#privateEmail').val() : $('#companyEmail').val(),
                Telephone: userType === 'private' ? $('#privateTelephone').val() : $('#companyTelephone').val(),
                DevisId: devisId,
                StartDate: startDate,
                EndDate: endDate,
                DeliveryEnabled: deliveryEnabled,
                EndLat: deliveryEnabled ? selectedEnd.lat : null,
                EndLon: deliveryEnabled ? selectedEnd.lon : null
            };

            // Chiamata al backend
            $.ajax({
                url: '/Devis/CalculateDevis',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(dataToSend),
                beforeSend: function () {
                    // Mostra lo spinner e nascondi il testo
                    button.prop('disabled', true);
                    buttonText.text('Veuillez patienter pendant le chargement...');
                    spinner.removeClass('d-none');
                },
                success: function (response) {
                    if (response.error) {
                        $('#result').html(`<div class="alert alert-danger">${response.error}</div>`);
                        $('#result').show();
                    } else {
                        // Struttura del risultato come una fattura
                        const resultText = `
                            <table class="table table-bordered" id="tableResult">
                                <tbody>
                                    <tr>
                                        <th class="w-50">Produit</th>
                                        <td class="w-50">@ViewBag.ProdName</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">Type de Client</th>
                                        <td class="w-50">${userType === 'private' ? 'Privé' : 'Professionnel'}</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">Nom</th>
                                        <td class="w-50">${dataToSend.Name}</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">Téléphone</th>
                                        <td class="w-50">${dataToSend.Telephone || 'Non fourni'}</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">E-mail</th>
                                        <td class="w-50">${dataToSend.Email || 'Non fourni'}</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">Date de début</th>
                                        <td class="w-50">${startDate}</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">Date de fin</th>
                                        <td class="w-50">${endDate}</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">Livraison</th>
                                        <td class="w-50">${deliveryEnabled ? 'Oui' : 'Non'}</td>
                                    </tr>
                                    ${deliveryEnabled ? `
                                    <tr>
                                        <th class="w-50">Adresse de Livraison</th>
                                        <td class="w-50" id="placeName">${response.placeName}</td>
                                    </tr>
                                    <tr>
                                        <th class="w-50">Prix Livraison</th>
                                        <td class="w-50" id="prixLivraisonResult">${response.priceLivraison.toFixed(2)} €</td>
                                    </tr>` : ''}
                                    <tr>
                                        <th class="w-50">Prix Total</th>
                                        <td class="w-50" id="prixTotalResult"><b>${response.priceTotal.toFixed(2)} €</b></td>
                                    </tr>
                                </tbody>
                            </table>
                            <button id="reserveButton" class="btn btn-lg btn-success w-100" style="margin-top: 15px;">
                                <span id="buttonTextR">Demandez une réservation dès maintenant</span>
                                <span id="spinnerR" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            </button>
                `;
                        $('#result').html(resultText);
                        $('#result').show();
                    }
                },
                error: function () {
                    $('#result').html('<div class="alert alert-danger">Une erreur est survenue lors du calcul du devis.</div>');
                    $('#result').show();
                },
                complete: function () {
                    // Ripristina il testo del pulsante e nascondi lo spinner
                    button.prop('disabled', false);
                    buttonText.text('Calculer le devis');
                    spinner.addClass('d-none');
                }
            });
        });

        // Delegazione dell'evento per il pulsante dinamico
        $('#result').on('click', '#reserveButton', function () {
            const button = $('#reserveButton'); // Testo del pulsante
            const buttonText = $('#buttonTextR'); // Testo del pulsante
            const spinner = $('#spinnerR'); // Spinner

            // Determina il tipo di utente
            const userType = $('input[name="userType"]:checked').val();

            // Dati comuni
            const startDate = userType === 'private' ? $('#privateStartDate').val() : $('#companyStartDate').val();
            const endDate = userType === 'private' ? $('#privateEndDate').val() : $('#companyEndDate').val();

            // Prepara i dati da inviare al server
            const reservationData = {
                ProdName: "@ViewBag.ProdName",
                UserType: userType,
                Name: userType === 'private' ? $('#privateName').val() : $('#companyName').val(),
                Email: userType === 'private' ? $('#privateEmail').val() : $('#companyEmail').val() || '',
                Telephone: userType === 'private' ? $('#privateTelephone').val() : $('#companyTelephone').val(),
                StartDate: startDate,
                EndDate: endDate,
                DeliveryEnabled: deliveryEnabled,
                EndLat: deliveryEnabled ? selectedEnd.lat : null,
                EndLon: deliveryEnabled ? selectedEnd.lon : null,
                Localisation: $('#placeName').text().trim(),
                DevisId: $('#devisIdTrack').val(),
                PrixLivraison: $('#prixLivraisonResult').text().trim(),
                PrixTotal: $('#prixTotalResult').text().trim()
            };

            // Invia i dati al server tramite AJAX
            $.ajax({
                url: '/Devis/Reserve',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(reservationData),
                beforeSend: function () {
                    // Mostra lo spinner e nascondi il testo
                    button.prop('disabled', true);
                    buttonText.text('Veuillez patienter pendant le chargement...');
                    spinner.removeClass('d-none');
                },
                success: function (response) {
                    if (response.success) {
                        // Se c'è un redirectUrl, esegui il redirect
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl; // Redirect alla nuova pagina
                        } else {
                            alert('Réservation réussie!');
                        }
                    } else {
                        alert('Erreur lors de la réservation.');
                    }
                },
                error: function (error) {
                    alert('Erreur lors de la réservation.');
                    console.error(error);
                },
                complete: function () {
                    // Ripristina il testo del pulsante e nascondi lo spinner
                    button.prop('disabled', false);
                    buttonText.text('Demandez une réservation dès maintenant');
                    spinner.addClass('d-none');
                }
            });
        });
    </script>
