    }

    .flatpickr-prev-month svg {
        vertical-align: top;
    }

    .flatpickr-day.selected {
        background: #ffc97f !important; /*#9bc8ff !important;*/
        -webkit-box-shadow: none !important;
        box-shadow: none !important;
        color: #ffff !important;
    }

    .selected-first {
