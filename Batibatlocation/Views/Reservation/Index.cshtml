
@{
    ViewBag.Title = "Réservation Produit BatiBat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let prodId = @ViewBag.ProdID; // Sostituisci con il valore corretto del prodotto
        var controller = "Reservation";
        sendLocation(prodId, controller);
    });
</script>

