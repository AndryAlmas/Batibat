@{
    ViewBag.Title = "Produits";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@model PagedList.IPagedList<Batibatlocation.Models.Category>

@using PagedList.Mvc
@using PagedList
@Html.AntiForgeryToken()

<h3>Categories</h3>
<hr />
<div class="row">
    <div class="offset-md-10"></div>
    <div class="col-md-2 d-flex align-items-end justify-content-end">
        <div class="col-md-12 text-right">
            <button id="btnAddCategory" class="btn btn-success mb-3">
                <i class="fas fa-plus"></i> Nouvelle Catégorie
            </button>
        </div>
    </div>
</div>

<!-- Form nascosto per creare una nuova categoria -->
<form id="createCategoryForm" action="@Url.Action("CreateCategorie", "Admin", new { page = Model.PageNumber })" method="post" style="display: none;">
    <input type="hidden" name="Nom" id="newCategoryName" />
    <input type="hidden" name="PrixKm" id="newPrixKm" />
    <input type="hidden" name="PrixMin" id="newPrixMin" />
</form>

<div class="table-responsive">
    <table id="categoriesTable" class="table table-striped">
        <thead class="thead-light">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Livraison: Prix Au Km</th>
                <th>Livraison: Prix Minimum</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{ int i = 0;}

            @foreach (var categorie in Model)
            {
                <tr>
                    @using (Html.BeginForm("EditCategorie", "Admin", new { page = Model.PageNumber }, FormMethod.Post, new { @id = $"editForm-{categorie.Id}" }))
                    {

                        @Html.HiddenFor(model => Model.ElementAtOrDefault(i).Id)

                        <td>@categorie.Id</td>
                        <td>
                            @Html.EditorFor(model => Model.ElementAtOrDefault(i).Nom, new { htmlAttributes = new { @id = $"inputNom-{categorie.Id}", @class = "form-control", placeholder = "Nom de l'échafaudage", disabled = "disabled", required = "required" } })
                        </td>
                        <td>
                            <input type="number" step="0.01" id="PrixAuKm_@categorie.Id" name="PrixAuKm_@categorie.Id" value="@Convert.ToDouble(Model.ElementAtOrDefault(i).CostiLivraisons.FirstOrDefault().PrixAuKm).ToString().Replace(',', '.')" class="form-control" disabled="disabled"/>
                        </td>
                        <td>
                            <input type="number" step="0.01" id="PrixMin_@categorie.Id" name="PrixMin_@categorie.Id" value="@Convert.ToDouble(Model.ElementAtOrDefault(i).CostiLivraisons.FirstOrDefault().PrixMin).ToString().Replace(',', '.')" class="form-control" placeholder="Prix minimum"  disabled="disabled"/>
                        </td>
                    }
                    <td class="text-right">
                        <div id="dropdownContainer-@categorie.Id" class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton-@categorie.Id" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fa fa-cog"></i>
                            </button>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton-@categorie.Id">
                                <a class="btn dropdown-item" onclick="mostraFormCategorie('@categorie.Id')">Modifier</a>
                                <button type="button" class="dropdown-item text-danger trigger-modal"
                                        data-action="@Url.Action("DeleteCategorie", "Admin", new { id = categorie.Id, page = Model.PageNumber })"
                                        data-title="Supprimer la catégorie"
                                        data-message="Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est irréversible."
                                        data-confirm-button="Oui, supprimer"
                                        data-cancel-button="Annuler">
                                    Supprimer
                                </button>

                            </div>
                        </div>

                        <div id="formContainer-@categorie.Id" style="display:none">
                            <div class="form-group float-md-right m-1">
                                <a href="#" onclick="nascondiFormCategorie('@categorie.Id','@Model.ElementAtOrDefault(i).Nom', '@Model.ElementAtOrDefault(i).CostiLivraisons.FirstOrDefault().PrixAuKm', '@Model.ElementAtOrDefault(i).CostiLivraisons.FirstOrDefault().PrixMin')" class="btn btn-secondary">Annuler</a>
                            </div>
                            <div class="form-group float-md-right m-1">
                                <input type="submit" form="editForm-@categorie.Id" value="Enregistrer" class="btn btn-primary" />
                            </div>
                        </div>
                    </td>

                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("Categories", new { page }),
        new PagedListRenderOptions
        {
            LiElementClasses = new List<string> { "page-link" },
            UlElementClasses = new List<string> { "pagination" },
            LinkToFirstPageFormat = "«« Première",
            LinkToPreviousPageFormat = "« Précédente",
            LinkToNextPageFormat = "Suivante »",
            LinkToLastPageFormat = "Dernière »»",
            DisplayLinkToFirstPage = PagedListDisplayMode.Never,
            DisplayLinkToLastPage = PagedListDisplayMode.Never,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5,
            DisplayEllipsesWhenNotShowingAllPageNumbers = true,
            EllipsesFormat = "...",
        })
</div>