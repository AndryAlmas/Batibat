
@{
    ViewBag.Title = "Devis Produit BatiBat";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

@if (ViewBag.Localisation == true)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let prodId = @ViewBag.ProdID; // Sostituisci con il valore corretto del prodotto
            sendLocation(prodId);
        });
    </script>
}
<!-- Includi Flatpickr per il calendario -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
<style>

    .prevMonthDay, .prevMonthDay:hover, .nextMonthDay, .nextMonthDay:hover {
        color: white !important;
        cursor: not-allowed !important;
        background: white !important;
        border: 0px !important;
    }
    
    .disabled-calendar {
        pointer-events: none; /* Disabilita tutti i clic */
        opacity: 0.4 !important;
    }

    .flatpickr-weekdays {
        height: 60px !important;
    }

    .flatpickr-days {
        width: 100% !important;
        align-items: stretch !important;
        flex-wrap: nowrap !important;
        align-content: center !important;
        justify-content: center !important;
        flex-direction: column !important;
    }

    /* Allinea i giorni su colonne da 7 e aumenta lo spazio tra gli elementi */
    .dayContainer {
        width: auto !important;
        min-width: auto !important;
        max-width: none !important;
        display: grid !important;
        grid-template-columns: repeat(7, 1fr) !important; /* 7 colonne uguali */
        justify-content: center !important; /* Centra la griglia */
    }

    .flatpickr-day {
        width: auto !important;
        height: 40px !important; /* Altezza fissa */
        line-height: 40px !important; /* Allinea il testo al centro verticalmente */
        font-size: 16px !important; /* Dimensione del testo */
        text-align: center !important; /* Allinea il testo al centro orizzontalmente */
        max-width: none !important;
        border-radius: 0 !important;
    }

    .flatpickr-day {
        font-weight: bold;
        font-size: large;
    }
    .flatpickr-day.flatpickr-disabled, .flatpickr-day.flatpickr-disabled:hover {
        color: #c8c8c8;
    }
    .flatpickr-day.today{
        color: red !important;
    }
    .flatpickr-calendar.inline {
        display: block !important;
        position: static !important;
        margin: 0 auto !important;
        width: auto !important;
        /*max-width: 307.875px !important;*/
        margin-top: 1rem !important;
    }

    .flatpickr-calendar {
        padding: 0.5vw !important;
        border: 2px solid black !important;
    }

    .flatpickr-innerContainer {
        flex-direction: column-reverse;
        justify-content: center;
    }

    .flatpickr-months .flatpickr-prev-month.flatpickr-next-month, .flatpickr-months .flatpickr-next-month.flatpickr-next-month {
        right: 34px !important;
    }

    .flatpickr-months .flatpickr-prev-month.flatpickr-prev-month, .flatpickr-months .flatpickr-next-month.flatpickr-prev-month {
        left: 34px !important;
    }

    .flatpickr-months .flatpickr-prev-month, .flatpickr-months .flatpickr-next-month {
        top: 60px !important;
        border-radius: 50% !important;
        background: #dedede !important;
    }

    .flatpickr-next-month svg {
        vertical-align: top;
    }

    .flatpickr-prev-month svg {
        vertical-align: top;
    }

    .flatpickr-day.selected {
        background: #9bc8ff !important;
        -webkit-box-shadow: none !important;
        box-shadow: none !important;
        color: #ffff !important;
    }

    .selected-first {
        background: #569ff7 !important;
        -webkit-box-shadow: none !important;
        box-shadow: none !important;
        color: black !important;
    }

    .selected-max {
        background: #569ff7 !important;
        -webkit-box-shadow: none !important;
        box-shadow: none !important;
        color: black !important;
        /*border-color: transparent !important;*/
    }

    /* Stile per il toggle switch */
    .custom-checkbox {
        display: flex;
        justify-content: flex-start;
        gap: 8px;
        flex-direction: row;
        flex-wrap: nowrap;
        align-content: center;
        align-items: flex-end;
    }

        .custom-checkbox input[type="checkbox"] {
            width: 25px; /* Dimensione del checkbox */
            height: 25px; /* Dimensione del checkbox */
            accent-color: #0d6efd; /* Colore del checkbox (blu Bootstrap) */
        }
    /* Stili personalizzati per il sottomenù dei suggerimenti */
    .suggestions-list {
        background-color: #f8f9fa; /* Grigio chiaro */
        border: 1px solid #dee2e6; /* Bordo leggero */
        border-radius: 4px; /* Angoli arrotondati */
        max-height: 150px; /* Altezza massima */
        overflow-y: auto; /* Scorrimento verticale se necessario */
        display: none; /* Nascondi di default */
    }

        .suggestions-list li {
            padding: 8px 12px; /* Spaziatura interna */
            cursor: pointer; /* Indica che è cliccabile */
            border-bottom: 1px solid #e9ecef; /* Delimitatore tra gli elementi */
        }

            .suggestions-list li:last-child {
                border-bottom: none; /* Rimuovi il bordo dall'ultimo elemento */
            }

            .suggestions-list li:hover {
                background-color: #e9ecef; /* Effetto hover leggero */
            }

    .list-group-item {
        display: list-item !important;
        border: 0px solid rgba(0, 0, 0, .125) !important;
    }

    .card-header {
        background-color: #ffae3c;
        /*        background: radial-gradient(circle, rgba(255,174,60,1) 0%, rgba(255,174,60,1) 70%, rgba(202,85,84,1) 100%);*/
        color: #a6201f !important;
        font-size: 28px;
        font-weight: bold;
        padding: 20px;
        border-radius: 40px !important;
        margin: 40px !important;
        border: 5px solid #ca5554;
    }

    .active-devis {
        background-color: #6a6a6a !important;
        color: white;
        border-radius: 40px !important;
        border-bottom: 0px !important;
    }

        .active-devis:hover {
            color: white;
        }

    .card {
        border-radius: 10px 10px 0 0 !important; /* Angoli arrotondati solo in alto */
    }

    .hero-devis {
        position: relative;
        background: linear-gradient(to top, #f7f7f7, #86929f);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .preHero-devis {
        background-image: url(../Content/Images/ECHAFAUDAGE_FACADE.jpg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        /* background-attachment: fixed; */
        z-index: 0;
        position: absolute;
        width: 120%;
        height: 100%;
        left: -10vw;
        opacity: 0.3;
    }

    label.btn, .label-btn {
        border-bottom: 2px solid #ff8900;
        border-radius: 0;
    }
</style>

<section id="hero" class="hero-devis">
    <div class="preHero-devis"></div>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header text-white text-center">
                        <h3 class="mb-0">Demande de Devis pour @ViewBag.ProdCat</h3>
                    </div>
                    <div class="card-body">

                        <!-- Radio Button Privato/Professionista -->
                        <div class="mb-4">
                            <label class="form-label text-bold text-bold">Vous êtes :</label>
                            <div class="btn-group w-100" role="group" aria-label="Type d'utilisateur">
                                <input type="radio" class="btn-check d-none" name="userType" id="privateRadio" value="private" checked required>
                                <label class="btn active-devis" for="privateRadio">Privé</label>

                                <input type="radio" class="btn-check d-none" name="userType" id="professionalRadio" value="professional" required>
                                <label class="btn non-active-devis" for="professionalRadio">Professionnel</label>
                            </div>
                        </div>

                        <hr />

                        <!-- Form per Privato -->
                        <div id="privateForm" class="user-form">
                            <div class="mb-3">
                                <label for="privateName" class="form-label text-bold">Nom et Prénom <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="privateName" placeholder="Entrez votre nom et prénom" required>
                            </div>
                            <br />
                            <div class="mb-3">
                                <label for="privateEmail" class="form-label text-bold">Adresse E-mail <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="privateEmail" placeholder="Entrez votre adresse e-mail" required>
                            </div>
                            <br />
                            <div class="row justify-content-center align-items-center">
                                <!-- Calendario per la data di inizio -->
                                <div class="col-md-6 text-center">
                                    <label class="form-label text-bold">Date de Début de Location <span class="text-danger">*</span></label>
                                    <div id="privateStartDateCalendar" class="flatpickr-inline mx-auto"></div>
                                    <input type="hidden" data-type="@ViewBag.ProdCat" id="privateStartDate" required>
                                </div>

                                <!-- Calendario per la data di fine -->
                                <div class="col-md-6 text-center">
                                    <label class="form-label text-bold">Date de Fin de Location <span class="text-danger">*</span></label>
                                    <div id="privateEndDateCalendar" class="flatpickr-inline mx-auto"></div>
                                    <input type="hidden" data-type="@ViewBag.ProdCat" id="privateEndDate" required disabled>
                                </div>
                            </div>
                        </div>

                        <!-- Form per Professionista -->
                        <div id="professionalForm" class="user-form" style="display: none;">
                            <div class="mb-3">
                                <label for="companyName" class="form-label text-bold">Nom de l'Entreprise <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="companyName" placeholder="Entrez le nom de votre entreprise" required>
                            </div>
                            <br />
                            <div class="mb-3">
                                <label for="companyEmail" class="form-label text-bold">Adresse E-mail <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="companyEmail" placeholder="Entrez votre adresse e-mail" required>
                            </div>
                            <br />
                            <div class="row justify-content-center align-items-center">
                                <!-- Calendario per la data di inizio -->
                                <div class="col-md-6 text-center">
                                    <label class="form-label text-bold">Date de Début de Location <span class="text-danger">*</span></label>
                                    <div id="companyStartDateCalendar" class="flatpickr-inline mx-auto"></div>
                                    <input type="hidden" data-type="@ViewBag.ProdCat" id="companyStartDate" required>
                                </div>

                                <!-- Calendario per la data di fine -->
                                <div class="col-md-6 text-center">
                                    <label class="form-label text-bold">Date de Fin de Location <span class="text-danger">*</span></label>
                                    <div id="companyEndDateCalendar" class="flatpickr-inline mx-auto"></div>
                                    <input type="hidden" data-type="@ViewBag.ProdCat" id="companyEndDate" required disabled>
                                </div>
                            </div>
                        </div>
                        <br />
                        <hr />
                        <!-- Switch Livraison -->
                        <div class="btn-group d-flex justify-content-center mb-4" role="group" aria-label="Livraison options">
                            <button type="button" class="non-active-devis btn w-50 label-btn" id="avecLivraison">Avec Livraison</button>
                            <button type="button" class="active-devis btn w-50 label-btn" id="sansLivraison">Sans Livraison</button>
                        </div>
                        <br />
                        <!-- Sezione Indirizzi (disabilitata di default) -->
                        <div id="deliverySection" style="display: none;">
                            <div class="mb-3">
                                <label for="endAddress" class="form-label text-bold">Adresse de Livraison <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="endAddress" placeholder="Entrez l'adresse d'arrivée" required>
                                <ul id="endSuggestions" class="suggestions-list"></ul>
                            </div>
                        </div>
                        <br />
                        <!-- Pulsante Calcola Preventivo -->
                        <div class="d-grid text-end" style="margin-bottom: 5rem !important">
                            <button type="button" id="calculateQuote" class="btn btn-primary btn-lg float-right">Calculer le Devis</button>
                        </div>

                        <!-- Risultato -->
                        <div id="result" class="mt-4 text-center"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Oggetto globale per tenere traccia dei calendari
            const flatpickrInstances = {};

            function generateAvailableDates(startDate) {
                const availableDates = [];
                if (startDate != undefined) {
                    let currentDate = new Date(startDate);

                    // Helper per formattare la data in DD/MM/YYYY
                    function formatDate(date) {
                        const day = String(date.getDate()).padStart(2, '0'); // Giorno con zero iniziale
                        const month = String(date.getMonth() + 1).padStart(2, '0'); // Mese con zero iniziale
                        const year = date.getFullYear();
                        return `${day}/${month}/${year}`;
                    }

                    const nextDate = new Date(currentDate); // Crea una nuova data basata sulla data corrente
                    for (let i = 1; i <= 52; i++) { // Genera fino a 52 settimane - 1 anno (puoi modificare il limite)
                        if (i == 1) {
                            nextDate.setDate(nextDate.getDate() + 6); // Aggiungi 6 per la prima settimana
                        }
                        else {
                            nextDate.setDate(nextDate.getDate() + 7); // Aggiungi 7 giorni alla volta
                        }
                        availableDates.push({
                            display: formatDate(nextDate), // Formato visibile (DD/MM/YYYY)
                            value: nextDate.toISOString().split('T')[0] // Formato interno (YYYY-MM-DD)
                        });
                    }
                }
                return availableDates;
            }

            // Inizializza Flatpickr per tutti i campi con classe "flatpickr-inline"
            const initializeFlatpickr = (calendarId, inputId, isStartDate) => {
                const calendarElement = document.getElementById(calendarId);
                const inputElement = document.getElementById(inputId);

                const picker = flatpickr(calendarElement, {
                    dateFormat: "d/m/Y",
                    locale: "fr",
                    inline: true,
                    minDate: "today",
                    onMonthChange: function (selectedDates, dateStr, instance) {
                        checkAndApplySelectedClasses(calendarId, inputId);
                    },
                    onChange: function (selectedDates, dateStr) {
                        inputElement.value = dateStr;

                        const endDateInputId = inputId.replace('StartDate', 'EndDate');
                        const endDateCalendarId = calendarId.replace('StartDate', 'EndDate');
                        const endDateInput = document.getElementById(endDateInputId);
                        const endDatePicker = flatpickrInstances[endDateInputId + "Picker"];

                        if (isStartDate) {
                            //elimino tutti i selected dai due calendari
                            if (endDateInput && endDatePicker) {
                                endDateInput.value = '';
                                $("#" + endDateCalendarId).nextAll("div").removeClass("disabled-calendar");



                                if (inputElement.dataset.type === "Echafaudage") {
                                    const availableDates = generateAvailableDates(selectedDates[0]);

                                    if (availableDates.length > 0) {
                                        endDatePicker.set({
                                            enable: availableDates.map(date => ({ from: date.display, to: date.display })),
                                            minDate: selectedDates[0]
                                        });

                                        // Calcola la data di inizio + 6 giorni
                                        const startDatePlus6Days = new Date(selectedDates[0]);
                                        startDatePlus6Days.setDate(startDatePlus6Days.getDate() + 6);

                                        // Imposta la vista del calendario sul mese di startDatePlus6Days
                                        endDatePicker.setDate(startDatePlus6Days, true, { view: 'month' });
                                    }
                                    else {
                                        endDatePicker.set({
                                            enable: [],
                                            minDate: "today"
                                        });
                                    }
                                } else {
                                    endDatePicker.set({
                                        minDate: selectedDates[0]
                                    });
                                }


                            }
                        }
                        // Controlla se entrambi gli input sono valorizzati
                        checkAndApplySelectedClasses(calendarId, inputId);
                    }
                });
                return picker;
            };

            // Inizializza tutti i calendari all'avvio
            flatpickrInstances.privateStartDatePicker = initializeFlatpickr("privateStartDateCalendar", "privateStartDate", true);
            flatpickrInstances.privateEndDatePicker = initializeFlatpickr("privateEndDateCalendar", "privateEndDate", false);
            flatpickrInstances.companyStartDatePicker = initializeFlatpickr("companyStartDateCalendar", "companyStartDate", true);
            flatpickrInstances.companyEndDatePicker = initializeFlatpickr("companyEndDateCalendar", "companyEndDate", false);
            $("#privateEndDateCalendar").nextAll("div").addClass("disabled-calendar");
            $("#companyEndDateCalendar").nextAll("div").addClass("disabled-calendar");

            // Funzione per resettare i calendari
            const resetCalendars = () => {
                flatpickrInstances.privateStartDatePicker.clear() //.setDate("today");
                flatpickrInstances.companyStartDatePicker.clear() //.setDate("today");

                flatpickrInstances.privateEndDatePicker.clear();
                flatpickrInstances.companyEndDatePicker.clear();

                flatpickrInstances.privateStartDatePicker = initializeFlatpickr("privateStartDateCalendar", "privateStartDate", true);
                flatpickrInstances.privateEndDatePicker = initializeFlatpickr("privateEndDateCalendar", "privateEndDate", false);
                flatpickrInstances.companyStartDatePicker = initializeFlatpickr("companyStartDateCalendar", "companyStartDate", true);
                flatpickrInstances.companyEndDatePicker = initializeFlatpickr("companyEndDateCalendar", "companyEndDate", false);

                document.getElementById("privateStartDate").value = "";
                document.getElementById("privateEndDate").value = "";
                document.getElementById("companyStartDate").value = "";
                document.getElementById("companyEndDate").value = "";

                $("#privateEndDateCalendar").nextAll("div").addClass("disabled-calendar");
                $("#companyEndDateCalendar").nextAll("div").addClass("disabled-calendar");
            };

            // Gestione del cambio di stato tra Privé e Professionnel
            $('input[name="userType"]').change(function () {
                $('#privateRadio + label').toggleClass('active-devis', $('#privateRadio').is(':checked'));
                $('#professionalRadio + label').toggleClass('active-devis', $('#professionalRadio').is(':checked'));

                // Azzera i campi quando si cambia tipo di utente
                if ($('#privateRadio').is(':checked')) {
                    $('#privateForm input').val('').trigger('change'); // Azzera campi Privé
                    $('#privateForm').show();
                    $('#professionalForm').hide();
                } else {
                    $('#professionalForm input').val('').trigger('change'); // Azzera campi Professionnel
                    $('#privateForm').hide();
                    $('#professionalForm').show();
                }
                resetCalendars();
            });

            function checkAndApplySelectedClasses(calendarId, inputId) {
                const startDateInputId = inputId.replace('EndDate', 'StartDate');
                const endDateInputId = inputId.replace('StartDate', 'EndDate');

                const startDateStr = document.getElementById(startDateInputId).value;
                const endDateStr = document.getElementById(endDateInputId).value;

                if (startDateStr && endDateStr) {
                    const startDate = parseDate(startDateStr);
                    const endDate = parseDate(endDateStr);

                    if (startDate && endDate && startDate <= endDate) {
                        // Applica la classe .selected al primo calendario
                        const startCalendarElement = document.getElementById(calendarId.replace('EndDate', 'StartDate'));
                        // TODO - applica stile personalizzato alla data selezionata. 
                        addSelectedClassToFirstDate(startCalendarElement, startDate, endDate);

                        // Applica la classe .selected al secondo calendario
                        const endCalendarElement = document.getElementById(calendarId.replace('StartDate', 'EndDate'));
                        addSelectedClassToDates(endCalendarElement, startDate, endDate);
                    }
                }
            }

            function addSelectedClassToFirstDate(calendarElement, startDate, endDate) {
                // Seleziona tutti gli elementi .flatpickr-day nel calendario
                const flatpickrCalendar = calendarElement.nextElementSibling;
                const dayElements = flatpickrCalendar.querySelectorAll(".flatpickr-day");

                dayElements.forEach(day => {
                    // Ignora gli elementi con la classe .nextMonth o .prevMonth
                    //if (day.classList.contains("nextMonthDay") || day.classList.contains("prevMonthDay")) {
                    //    day.classList.remove("selected"); // rimuovo in caso sia già stato selezionato in precedenza
                    //    return;
                    //}

                    // Ottieni la data associata all'elemento
                    const dateStr = day.getAttribute("aria-label");
                    if (!dateStr) return;

                    const parsedDate = parseFrenchDate(dateStr);
                    const date = new Date(parsedDate);

                    // Verifica se la data è compresa nell'intervallo
                    if (areDatesEqual(date,startDate)) {
                        day.classList.remove("selected");
                        day.classList.add("selected-first");
                    } else {
                        day.classList.remove("selected-first");
                    }
                });
            }

            function areDatesEqual(date1, date2) {
                if (!date1 || !date2) return false;

                return (
                    date1.getFullYear() === date2.getFullYear() &&
                    date1.getMonth() === date2.getMonth() &&
                    date1.getDate() === date2.getDate()
                );
            }

            function addSelectedClassToDates(calendarElement, startDate, endDate) {
                // Seleziona tutti gli elementi .flatpickr-day nel calendario
                const flatpickrCalendar = calendarElement.nextElementSibling;
                const dayElements = flatpickrCalendar.querySelectorAll(".flatpickr-day");

                dayElements.forEach(day => {
                    // Ignora gli elementi con la classe .nextMonth o .prevMonth
                    if (day.classList.contains("nextMonthDay") || day.classList.contains("prevMonthDay")) {
                        day.classList.remove("selected"); // rimuovo in caso sia già stato selezionato in precedenza
                        return;
                    }

                    // Ottieni la data associata all'elemento
                    const dateStr = day.getAttribute("aria-label");
                    if (!dateStr) return;

                    const parsedDate = parseFrenchDate(dateStr);
                    const date = new Date(parsedDate);

                    // Verifica se la data è compresa nell'intervallo
                    if (date >= startDate && date <= endDate) {
                        if (!day.getAttribute("tabindex")) // controllare che non ci sia nextMonth o prevMonth perché altrimenti lo colora nella parte di calendario sbagliata
                            day.classList.add("selected");
                        else {
                            day.classList.remove("selected");
                            day.classList.add("selected-max");
                        }
                    } else {
                        day.classList.remove("selected");
                    }
                });
            }
            // Funzione per convertire una stringa dd/mm/yyyy in un oggetto Date
            function parseDate(dateStr) {
                const [day, month, year] = dateStr.split("/").map(Number); // Dividi la stringa e converti in numeri
                return new Date(year, month - 1, day); // Crea un oggetto Date (mese è zero-based)
            }

            function parseFrenchDate(dateStr) {
                // Mapping dei nomi dei mesi francesi
                const frenchMonths = {
                    "janvier": 0, "février": 1, "mars": 2, "avril": 3,
                    "mai": 4, "juin": 5, "juillet": 6, "août": 7,
                    "septembre": 8, "octobre": 9, "novembre": 10, "décembre": 11
                };

                // Estrai il mese, il giorno e l'anno dalla stringa
                const parts = dateStr.toLowerCase().split(" ");
                if (parts.length !== 3) {
                    console.error("Formato della data non valido:", dateStr);
                    return null;
                }

                const monthName = parts[0]; // Mese in francese
                const day = parseInt(parts[1].replace(",", ""), 10); // Giorno (rimuovi la virgola)
                const year = parseInt(parts[2], 10); // Anno

                // Trova il numero del mese corrispondente
                const month = frenchMonths[monthName];
                if (month === undefined) {
                    console.error("Mese non riconosciuto:", monthName);
                    return null;
                }

                // Crea un oggetto Date (il mese è zero-based in JavaScript)
                return new Date(year, month, day);
            }
        });

        let selectedStart = null;
        let selectedEnd = null;

        document.getElementById('avecLivraison').addEventListener('click', function () {
            this.classList.add('active-devis');
            $('#deliverySection').show();
            document.getElementById('sansLivraison').classList.remove('active-devis');
        });

        document.getElementById('sansLivraison').addEventListener('click', function () {
            this.classList.add('active-devis');
            $('#deliverySection').hide();
            selectedStart = null;
            selectedEnd = null;
            document.getElementById('avecLivraison').classList.remove('active-devis');
        });

        // Funzione per ottenere suggerimenti di indirizzi tramite Nominatim
        function getSuggestions(inputId, suggestionsId, callback) {
            const query = $('#' + inputId).val();
            if (query.length < 3) return; // Attiva la ricerca solo dopo 3 caratteri

            $.get(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=5`, function (data) {
                const suggestionsList = $('#' + suggestionsId);
                suggestionsList.empty().hide(); // Nascondi se non ci sono risultati
                if (data.length > 0) {
                    data.forEach(item => {
                        const suggestion = $('<li>').addClass('list-group-item').text(item.display_name);
                        suggestion.click(function () {
                            $('#' + inputId).val(item.display_name);
                            suggestionsList.empty().hide();
                            callback({ lat: item.lat, lon: item.lon });
                        });
                        suggestionsList.append(suggestion);
                    });
                    suggestionsList.show();
                }
            });
        }

        // Gestione dell'input di arrivo
        $('#endAddress').on('input', function () {
            getSuggestions('endAddress', 'endSuggestions', function (coords) {
                selectedEnd = coords;
            });
        });

        // Funzione di validazione dei campi
        function validateFields(userType) {
            let errors = [];

            if (userType === 'private') {
                // Validazione per Privé
                if (!$('#privateName').val()) errors.push("Le nom et prénom sont obligatoires.");
                if (!$('#privateEmail').val()) errors.push("L'adresse e-mail est obligatoire.");
                if (!$('#privateStartDate').val()) errors.push("La date de début de location est obligatoire.");
                if (!$('#privateEndDate').val()) errors.push("La date de fin de location est obligatoire.");
            } else {
                // Validazione per Professionnel
                if (!$('#companyName').val()) errors.push("Le nom de l'entreprise est obligatoire.");
                if (!$('#companyEmail').val()) errors.push("L'adresse e-mail est obligatoire.");
                if (!$('#companyStartDate').val()) errors.push("La date de début de location est obligatoire.");
                if (!$('#companyEndDate').val()) errors.push("La date de fin de location est obligatoire.");
            }

            // Validazione generale per la consegna
            if ($('#deliverySwitch').is(':checked')) {
                if (!selectedEnd) errors.push("Veuillez sélectionner les adresses de départ et d'arrivée.");
            }

            return errors;
        }

        // Funzione unica per calcolare il preventivo
        $('#calculateQuote').click(function () {
            // Determina il tipo di utente
            const userType = $('input[name="userType"]:checked').val();
            const deliveryEnabled = $('#deliverySwitch').is(':checked');

            // Dati comuni
            const startDate = userType === 'private' ? $('#privateStartDate').val() : $('#companyStartDate').val();
            const endDate = userType === 'private' ? $('#privateEndDate').val() : $('#companyEndDate').val();

            // Validazione dei campi
            const validationErrors = validateFields(userType);
            if (validationErrors.length > 0) {
                $('#result').html(`<div class="alert alert-danger">${validationErrors.join("<br>")}</div>`);
                return;
            }

            // Preparazione dei dati da inviare al backend
            const dataToSend = {
                UserType: userType,
                ProdID: @ViewBag.ProdID,
                Name: userType === 'private' ? $('#privateName').val() : $('#companyName').val(),
                Email: userType === 'private' ? $('#privateEmail').val() : $('#companyEmail').val(),
                StartDate: startDate,
                EndDate: endDate,
                DeliveryEnabled: deliveryEnabled,
                EndLat: deliveryEnabled ? selectedEnd.lat : null,
                EndLon: deliveryEnabled ? selectedEnd.lon : null
            };

            // Chiamata al backend
            $.ajax({
                url: '/Devis/CalculateDevis',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(dataToSend),
                success: function (response) {
                    if (response.error) {
                        $('#result').html(`<div class="alert alert-danger">${response.error}</div>`);
                    } else {
                        // Struttura del risultato come una fattura
                        const resultText = `
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th>Produit</th>
                                        <td>@ViewBag.ProdName</td>
                                    </tr>
                                    <tr>
                                        <th>Type d'utilisateur</th>
                                        <td>${userType === 'private' ? 'Privé' : 'Professionnel'}</td>
                                    </tr>
                                    <tr>
                                        <th>Nom</th>
                                        <td>${dataToSend.Name}</td>
                                    </tr>
                                    <tr>
                                        <th>E-mail</th>
                                        <td>${dataToSend.Email || 'Non fourni'}</td>
                                    </tr>
                                    <tr>
                                        <th>Date de début</th>
                                        <td>${startDate}</td>
                                    </tr>
                                    <tr>
                                        <th>Date de fin</th>
                                        <td>${endDate}</td>
                                    </tr>
                                    <tr>
                                        <th>Livraison</th>
                                        <td>${deliveryEnabled ? 'Oui' : 'Non'}</td>
                                    </tr>
                                    ${deliveryEnabled ? `<tr>
                                        <th>Distance</th>
                                        <td>${response.distance} km</td>
                                    </tr>` : ''}
                                    <tr>
                                        <th>Prix Total</th>
                                        <td>${response.price.toFixed(2)} €</td>
                                    </tr>
                                </tbody>
                            </table>
                `;
                        $('#result').html(resultText);
                    }
                },
                error: function () {
                    $('#result').html('<div class="alert alert-danger">Une erreur est survenue lors du calcul du devis.</div>');
                }
            });
        });
    </script>
}