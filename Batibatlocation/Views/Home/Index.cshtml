@{
    ViewBag.Title = "Bati'Bat Location d'Echafaudages - Accueil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listaPromozioni = new List<Batibatlocation.Models.Promotion>();
}
@model IEnumerable<Batibatlocation.Models.Produit>
@if ((List<Batibatlocation.Models.Promotion>)ViewBag.PromotionList != null)
{
    listaPromozioni = (List<Batibatlocation.Models.Promotion>)ViewBag.PromotionList;
}
@if (Model.Any())
{
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "ItemList",
        "itemListElement": [
            @foreach (var produit in Model)
            {
                <text>
                {
                    "@@type": "Product",
                    "name": "@produit.Nom",
                    "description": "@produit.Description",
                    "image": "@produit.ImageUrl",
                    "url": "@Url.Action("Details", "Produit", new { slug = Batibatlocation.Helpers.SlugName.GenerateSlug(produit.Id, produit.Nom) })",
                    "offers": {
                        "@@type": "Offer",
                        "price": "@produit.Prix.ToString().Replace(",", ".")",
                        "priceCurrency": "EUR"
                    }
                }@((Model.ToList().IndexOf(produit) < Model.Count() - 1) ? "," : "")
                </text>
            }
        ]
    }
    </script>
}

@*HERO Section*@
<section id="hero" class="hero d-flex align-items-center justify-content-center">
    <div class="preHero"></div>
    <img id="LogoHeroSection" class="hero-img fade-out" src="~/Content/Images/LogoBatibatSVG.svg" alt="Logo Bati'Bat Location Echaufaudages, Le partenaire de vos projets">
    <div class="hero-content text-center">
        <p class="construction-subtext">"Le partenaire de vos projets."</p>
    </div>
    <!-- SVG a forma di tetto -->
    <svg class="roof-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 20" preserveAspectRatio="none">
        <polygon points="0,20 50,0 100,20" style="fill:#f8f9fa;" />
    </svg>
</section>
<br>
@if (Model.Any())
{
    <section id="produits">
        <div class="container">
            <h2 class="text-center mb-4">Nos Produits</h2>
            <hr><br>
            <div class="row">
                @foreach (var produit in Model)
                {
                    if (listaPromozioni.ToList().Where(l => (l.CategoryId ?? -1) == produit.CategoryId || (l.ProductId ?? -1) == produit.Id).Any())
                    {
                        var promo = listaPromozioni.ToList().Where(prm => (prm.CategoryId ?? -1) == produit.CategoryId).FirstOrDefault();
                        if (promo == null)
                        {
                            promo = listaPromozioni.Where(l => l.ProductId == produit.Id).FirstOrDefault();
                        }
                        <div class="col-md-6 mb-4">
                            <figure class="snip-produit hover d-flex flex-column">
                                <div class="snip-image-area d-flex flex-column">
                                    <!-- Adesivo a forma di cerchio -->
                                    <div class="discount-sticker-circle">
                                        <div class="discount-text">
                                            @if (promo.IsPercentage)
                                            {
                                                <span>- @Batibatlocation.Helpers.Calcules.SansVirgule(promo.DiscountValue)% <sup>(*)</sup></span>
                                                <span style="font-size: 9px; font-weight: normal; display: flex; justify-content: center;"> Jusqu'au</span>
                                                <span style="font-size: 9px; font-weight: normal; display: flex; justify-content: center;"> @promo.EndDate.Value.ToShortDateString()</span>
                                            }
                                            else
                                            {
                                                <span>- @Batibatlocation.Helpers.Calcules.SansVirgule(promo.DiscountValue)€ <sup>(*)</sup></span>
                                                <span style="font-size: 9px; font-weight: normal; display: flex; justify-content: center;"> Jusqu'au</span>
                                                <span style="font-size: 9px; font-weight: normal; display: flex; justify-content: center;"> @promo.EndDate.Value.ToShortDateString()</span>
                                            }
                                        </div>
                                    </div>
                                    <img src="@produit.ImageUrl" alt="@produit.Nom" />
                                    <div class="add-to-cart">
                                        <i class="fas fa-plus"></i><span>détails</span>
                                    </div>
                                </div>
                                <figcaption>
                                    <h3>@produit.Nom</h3>
                                    <p>@produit.Description</p>
                                    <div class="price">
                                        <span><s>@Batibatlocation.Helpers.Calcules.SansVirgule(produit.Prix)€</s></span>
                                        @Batibatlocation.Helpers.Calcules.PrixDiscount(produit.Prix, promo)€
                                        <span class="snip-price-period">par @produit.Periodicite.Nom.ToLower()</span>
                                    </div>
                                </figcaption>
                                <a href="@Url.Action("Details", "Produit", new { slug = Batibatlocation.Helpers.SlugName.GenerateSlug(produit.Id, produit.Nom) })"></a>
                            </figure>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6 mb-4">
                            <figure class="snip-produit hover d-flex flex-column">
                                <div class="snip-image-area d-flex flex-column">
                                    <img src="@produit.ImageUrl" alt="@produit.Nom" />
                                    <div class="add-to-cart"> <i class="fas fa-plus"></i><span>détails</span></div>
                                </div>
                                <figcaption>
                                    <h3>@produit.Nom</h3>
                                    <p>@produit.Description </p>
                                    <div class="price">
                                        @Batibatlocation.Helpers.Calcules.SansVirgule(produit.Prix)€ <span class="snip-price-period">par @produit.Periodicite.Nom.ToLower()</span>
                                    </div>
                                </figcaption><a href="@Url.Action("Details", "Produit", new { slug = Batibatlocation.Helpers.SlugName.GenerateSlug(produit.Id, produit.Nom) })"></a>
                            </figure>
                        </div>
                    }
                }
            </div>
            <section id="infoPromo">
                <div class="card-header font-italic" style="font-size:12px">
                    <b>(*)</b> Les promotions concernent uniquement le produit et n’incluent pas de réductions sur les frais de livraison.
                </div>
            </section>
        </div>
    </section>
}
else
{
    <style>

        #nosProduits {
            display: none;
        }

        #nosProduitsSideBar {
            display: none;
        }
    </style>
}
@*Service*@
<br>
<section id="services" class="services bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-4">Nos Services</h2>
        <hr><br>
        <div class="row row-services">
            <div class="col-md-6 mb-6">
                <div class="service-item d-flex flex-column bg-white shadow-sm">
                    <div class="square-banner-left d-flex align-items-center justify-content-center mb-3">
                        <div class="icon-container">
                            <i class="fa-solid fa-phone-alt iconservice-svg truck-color"></i>
                            <button class="click-icon-service" onclick="window.location.href='tel:+330695889208';">
                                <i class="fas fa-hand-pointer"></i>
                                <span class="click-service-effect"></span>
                            </button>
                        </div>
                        <div class="reservation-banner">Reservation</div>
                    </div>
                    <div class="p-4">
                        <h3 class="text-left">Location d'échafaudages</h3>
                        <p><span class="first-letter">N</span>ous sommes spécialisés dans la location d'échafaudages pour tous les types de chantiers. Nous proposons des solutions personnalisées pour répondre à tous vos besoins.</p>
                    </div>

                </div>
            </div>
            <div class="col-md-6 mb-6">
                <div class="service-item d-flex flex-column bg-white shadow-sm">
                    <div class="square-banner-right d-flex align-items-center justify-content-center mb-3">
                        <div class="icon-container">
                            <i class="fas fa-headset iconservice-svg assist-color"></i>
                            <button class="click-icon-service" onclick="window.location.href='tel:+330695889208';">
                                <i class="fas fa-hand-pointer"></i>
                                <span class="click-service-effect"></span>
                            </button>
                        </div>
                        <div class="assistence-banner">Assistance</div>
                    </div>
                    <div class="p-4">
                        <h3 class="text-left">Assistance et Maintenance</h3>
                        <p><span class="first-letter">N</span>ous offrons un suivi et une maintenance continus pour garantir que l'échafaudage est toujours en parfait état.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@*Contact*@
<section id="contact" class="contact py-5">
    <div class="container">
        <h2 class="text-center mb-4">Contactez-nous pour plus d'informations</h2>
        <hr><br>
        <div class="mail" style="margin-bottom: -3rem;">
            <div class="envelope-wrapper">
                <div class="envelope">
                    <div class="envelope-top"></div>
                </div>
                <button class="email-button">
                    Email
                    <div class="click-icon">
                        <i class="fas fa-hand-pointer"></i>
                        <div class="click-effect"></div>
                    </div>
                </button>
            </div>
        </div>
    </div>
</section>
